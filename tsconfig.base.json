{
  "compileOnSave": false,
  "compilerOptions": {
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "lib": ["es2022"],
    "importHelpers": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@kit": ["./packages/kit/src/index.ts"],
      "@contracts": ["./packages/contracts/src/index.ts"],
      "@design-system": ["./packages/design-system/src/index.ts"],
      "@domain/journal": ["./packages/domain/src/journal/index.ts"],
      "@domain/finance": ["./packages/domain/src/finance/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
