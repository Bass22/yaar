// Yaar — schema of the operational database (an infrastructure detail: the domain ignores it).
//
// Tenancy: `tenants` is the root, and every other table carries `tenant_id` NOT NULL with an
// index starting with it (CLAUDE.md §4 rule 5). A row only ever references rows of its own
// tenant: foreign keys go through (tenant_id, id), so the database itself refuses a campaign
// attached to the site of another farm.
//
// An identifier never changes and no row is erased: every foreign key refuses both (Restrict),
// so a tenant_id rewritten by mistake cannot cascade to the rows that depend on it.
//
// Identifiers are UUIDs given by the caller — created on the device for whatever is written
// offline — and never a server sequence (rule 2). Instants are stored with their time zone.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// The closed list of account avatars (E.9, 2026-11-07): drawn in packages/design-system as `avatar-<name>`.
enum AccountAvatar {
  baobab
  mango
  pirogue
  teapot
  calabash
  sheep
  goat
  watermelon
  fish
  star
  turtle
  drum

  @@map("account_avatar")
}

// The languages of the recorded voice clips (audio/<language>/).
enum AudioLanguage {
  wo
  fr

  @@map("audio_language")
}

enum UserRole {
  admin
  collaborator

  @@map("user_role")
}

// The closed list of facts of the journal (`Fact` in packages/domain). It only grows.
enum JournalEventType {
  Death
  BagOpened
  NoLoss
  Loss
  Delivery
  Weighing
  WeighingValidated
  TaskDone
  VoiceMessage
  Photo

  @@map("journal_event_type")
}

model Tenant {
  id        String   @id @db.Uuid
  name      String
  // ISO 4217 code of the money this farm counts in: never hard-coded (rule 7).
  currency  String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  users             User[]
  sites             Site[]
  siteAssignments   SiteAssignment[]
  campaigns         Campaign[]
  journalEvents     JournalEvent[]
  auditEvents       AuditEvent[]
  refusedEvents     RefusedEvent[]
  counterparties    Counterparty[]
  costTypes         CostType[]
  purchaseOrders    PurchaseOrder[]
  orderLines        OrderLine[]
  payments          Payment[]
  media             Media[]
  costs             Cost[]
  settlements       Settlement[]
  sales             Sale[]
  saleReceipts      SaleReceipt[]
  weighingRequests  WeighingRequest[]
  campaignLeftovers CampaignLeftover[]
  budgetLines       BudgetLine[]
  signInAttempts    SignInAttempt[]
  pushSubscriptions PushSubscription[]
  correctionReviews CorrectionReview[]
  morningReminders  MorningReminder[]
  receptionAlerts   ReceptionAlert[]
  plannedReceptions PlannedReception[]
  saleForecasts     SaleForecast[]
  attachments       Attachment[]
  catalogPrices     CatalogPrice[]

  @@map("tenants")
}

model User {
  id                      String         @id @db.Uuid
  tenantId                String         @map("tenant_id") @db.Uuid
  // The phone number is the login, written in international form (E.164): one account per
  // number on the whole service, so that a sign-in needs no tenant to find its user.
  phone                   String         @unique
  name                    String
  role                    UserRole
  // Recognised at sign-in, on the phone (E.9). Empty for an account made before its avatar was chosen.
  avatar                  AccountAvatar?
  // The language of the voice for this person (E.9): it follows the person, not the site. Empty: the site's.
  audioLanguage           AudioLanguage? @map("audio_language")
  // argon2id digest of the PIN (E.1). Never the PIN, never shown to anyone.
  pinHash                 String         @map("pin_hash")
  // Set while the PIN is the provisional one the admin gave (E.5): until then, signing in
  // means choosing one's own PIN. Past this instant, the provisional PIN no longer works.
  provisionalPinExpiresAt DateTime?      @map("provisional_pin_expires_at") @db.Timestamptz(3)
  // Failed PIN attempts in a row (E.1): the wait before the next one grows with them.
  // A blocked account is refused on every request, on every device (E.4).
  blockedAt               DateTime?      @map("blocked_at") @db.Timestamptz(3)
  // A session token issued before this instant — to the second, rounded up — is refused:
  // blocking, a new PIN or "sign out everywhere" set it. Empty until one of them happens.
  sessionsValidFrom       DateTime?      @map("sessions_valid_from") @db.Timestamptz(3)
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignments       SiteAssignment[]
  journalEvents     JournalEvent[]
  refusedEvents     RefusedEvent[]
  signInAttempts    SignInAttempt[]
  pushSubscriptions PushSubscription[]
  correctionReviews CorrectionReview[]

  @@unique([tenantId, id])
  @@map("users")
}

model Site {
  id            String         @id @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  name          String
  // IANA name ("Africa/Dakar"): it says which business day an instant falls on.
  timeZone      String         @map("time_zone")
  // Only the primary caretaker declares when the admin turns this on.
  strictMode    Boolean        @default(false) @map("strict_mode")
  // The voice of an account that chose none (E.9); set when the site is configured (O.1).
  audioLanguage AudioLanguage? @map("audio_language")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignments      SiteAssignment[]
  campaigns        Campaign[]
  morningReminders MorningReminder[]
  journalEvents    JournalEvent[]
  auditEvents      AuditEvent[]
  refusedEvents    RefusedEvent[]

  @@unique([tenantId, id])
  @@map("sites")
}

// A collaborator allowed to write in the notebook of a site: its primary caretaker, or a
// substitute. At most one primary per site (partial unique index, in the migration). The only
// row the application erases: removing someone from a site; the audit trail keeps it (E.7).
model SiteAssignment {
  tenantId  String   @map("tenant_id") @db.Uuid
  siteId    String   @map("site_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  isPrimary Boolean  @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  site   Site   @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([siteId, userId])
  @@index([tenantId, userId])
  @@map("site_assignments")
}

model Campaign {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  siteId           String    @map("site_id") @db.Uuid
  // The business day the animals were placed: day 0 of the campaign.
  placementDay     DateTime  @map("placement_day") @db.Date
  // A strain of the publisher (code of the domain, `Cobb500`): the campaign inherits its curve.
  strain           String
  // Chicks expected: for budgets and ratios, never the base of the live count.
  plannedHeadcount Int       @map("planned_headcount")
  // Days the campaign is expected to last (45 by default, 60 at most).
  plannedDuration  Int       @map("planned_duration")
  closedAt         DateTime? @map("closed_at") @db.Timestamptz(3)
  // Written once, at the closing (X.2): the campaign of the same site that receives the leftovers
  // (none without leftovers), and the admin's free comment on the report.
  leftoversTo      String?   @map("leftovers_to") @db.Uuid
  closingComment   String?   @map("closing_comment")
  // Why the bags of feed counted at the closing differ from those expected (N.8d); none: no gap.
  feedGapComment   String?   @map("feed_gap_comment")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  site           Site               @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  receiver       Campaign?          @relation("LeftoversTransfer", fields: [tenantId, leftoversTo], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  givers         Campaign[]         @relation("LeftoversTransfer")
  leftovers      CampaignLeftover[]
  saleForecasts  SaleForecast[]
  budgetLines    BudgetLine[]
  journalEvents  JournalEvent[]
  refusedEvents  RefusedEvent[]
  purchaseOrders PurchaseOrder[]

  costs            Cost[]
  sales            Sale[]
  weighingRequests WeighingRequest[]

  @@unique([tenantId, id])
  @@index([tenantId, siteId])
  @@map("campaigns")
}

// The journal: append-only. A row is one event exactly as it was written on a device — a
// declaration, a counter-declaration (`corrects`) or a retraction (`retracts`, no fact).
// The migration adds what Prisma cannot describe: no UPDATE, no DELETE, no TRUNCATE, for
// anyone; `received_at` set by the database whatever the client sends; and the shape of a row.
model JournalEvent {
  tenantId     String            @map("tenant_id") @db.Uuid
  // Created on the device: unique within its tenant, which makes ingestion idempotent.
  id           String            @db.Uuid
  siteId       String            @map("site_id") @db.Uuid
  campaignId   String            @map("campaign_id") @db.Uuid
  authorId     String            @map("author_id") @db.Uuid
  businessDate DateTime          @map("business_date") @db.Date
  // Read on the clock of the device when the event was written.
  recordedAt   DateTime          @map("recorded_at") @db.Timestamptz(3)
  // Read on the clock of the database when the row was inserted. Never taken from the client.
  receivedAt   DateTime          @default(now()) @map("received_at") @db.Timestamptz(3)
  // The device of the session that sent the event (UUID made on the device): from where (rule 14).
  deviceId     String            @map("device_id") @db.Uuid
  type         JournalEventType?
  // The fields of the fact, without its type.
  fact         Json?
  corrects     String?           @db.Uuid
  retracts     String?           @db.Uuid

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  site        Site              @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  campaign    Campaign          @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  author      User              @relation(fields: [tenantId, authorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  corrected   JournalEvent?     @relation("Corrections", fields: [tenantId, corrects], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  corrections JournalEvent[]    @relation("Corrections")
  retracted   JournalEvent?     @relation("Retractions", fields: [tenantId, retracts], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  retractions JournalEvent[]    @relation("Retractions")
  review      CorrectionReview?

  @@id([tenantId, id])
  @@map("journal_events")
}

// « Vu » on a correction a caretaker wrote (Y.2b, founder's decision of 2026-11-14): the card of
// « À traiter » stays until an admin touches it. Written once, never changed; the journal is untouched.
model CorrectionReview {
  tenantId     String   @map("tenant_id") @db.Uuid
  correctionId String   @map("correction_id") @db.Uuid
  reviewedBy   String   @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime @map("reviewed_at") @db.Timestamptz(3)

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  correction JournalEvent @relation(fields: [tenantId, correctionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  reviewer   User         @relation(fields: [tenantId, reviewedBy], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, correctionId])
  @@map("correction_reviews")
}

// A declaration the server refused by a rule of the trade, kept whole so that the chef sees it
// and can write it again for its day (G.5, decision of 2026-11-08). Append-only, like the journal.
// Only well-formed events of a campaign of the farm come here: an illegible one is not kept.
model RefusedEvent {
  tenantId     String   @map("tenant_id") @db.Uuid
  // The identifier the device gave the event: refused twice, it is kept once.
  eventId      String   @map("event_id") @db.Uuid
  // The site of the campaign the event names — the event's own site may be the wrong one.
  siteId       String   @map("site_id") @db.Uuid
  campaignId   String   @map("campaign_id") @db.Uuid
  authorId     String   @map("author_id") @db.Uuid
  deviceId     String   @map("device_id") @db.Uuid
  businessDate DateTime @map("business_date") @db.Date
  recordedAt   DateTime @map("recorded_at") @db.Timestamptz(3)
  // Read on the clock of the database when the row was inserted. Never taken from the client.
  receivedAt   DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  // The event as the device sent it, in the form of the contract.
  event        Json
  // Why: the kind of the refusal and what explains it.
  refusal      Json

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  site     Site     @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  campaign Campaign @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  author   User     @relation(fields: [tenantId, authorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, eventId])
  @@map("refused_events")
}

// What a sensitive action did, who did it, when and from which device (CLAUDE.md §4 rule 14).
enum AuditAction {
  SignInSucceeded
  SignInFailed
  SignInRefused
  PinChosen
  AccountCreated
  AccountBlocked
  AccountUnblocked
  SignedOutEverywhere
  PinReset
  SiteAssigned
  SiteUnassigned
  PrimaryCaretakerDesignated
  AdminAdded
  SiteCreated
  SiteConfigured
  CampaignOpened
  CounterpartyCreated
  CounterpartyConfigured
  CounterpartyArchived
  CostTypeCreated
  CostTypeConfigured
  CostTypeArchived
  OrderDrafted
  OrderRevised
  OrderAnnounced
  OrderClosed
  PaymentRecorded
  CostRecorded
  CostRevised
  SettlementRecorded
  SaleRecorded
  SaleReceiptRecorded
  WeighingRequested
  CampaignClosed
  BudgetRecorded
  CatalogPriceSet
  AttachmentAdded
  SaleForecastRecorded
  SaleForecastWithdrawn
  ReceptionPlanned
  ReceptionWithdrawn
  CorrectionReviewed

  @@map("audit_action")
}

// The audit trail: append-only, like the journal (triggers in the migration). It holds no
// secret: no PIN, no token, no phone number — identifiers and a reason from a closed list.
model AuditEvent {
  tenantId   String      @map("tenant_id") @db.Uuid
  id         String      @db.Uuid
  occurredAt DateTime    @map("occurred_at") @db.Timestamptz(3)
  action     AuditAction
  // Who acted: the admin, or the account itself when it signs in. Empty when the operator
  // acted, by script (an admin added, E.8): the operator has no account in any farm.
  actorId    String?     @map("actor_id") @db.Uuid
  // The account the action was about — or, for a site created or configured, the site; for a campaign opened, the campaign.
  subjectId  String      @map("subject_id") @db.Uuid
  // The site the action was about, when it was about one (an assignment).
  siteId     String?     @map("site_id") @db.Uuid
  // The device of the actor, as it names itself (UUID made on the device).
  deviceId   String?     @map("device_id") @db.Uuid
  // Why a sign-in was refused or failed: the kind of the refusal.
  reason     String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  site   Site?  @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, id])
  @@index([tenantId, subjectId, occurredAt])
  @@map("audit_events")
}

enum CounterpartyKind {
  Supplier
  Customer
  Collaborator

  @@map("counterparty_kind")
}

// A supplier, a customer or a collaborator of the farm (N.3): one side of the ledger, which
// never changes. Never deleted, not even unused: archived (decision of 2026-11-09). Its face is
// a pictogram of a closed list (the domain's COUNTERPARTY_FACES); no photograph in V1.
model Counterparty {
  tenantId         String           @map("tenant_id") @db.Uuid
  id               String           @id @db.Uuid
  kind             CounterpartyKind
  name             String
  // May advance money for the farm (R.7): only such counterparties are offered as « paid by ».
  advancesExpenses Boolean          @default(false) @map("advances_expenses")
  face             String
  archivedAt       DateTime?        @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  purchaseOrders PurchaseOrder[]

  costs         Cost[]
  settlements   Settlement[]
  paymentsMade  Payment[]      @relation("PaymentPaidBy")
  sales         Sale[]
  saleForecasts SaleForecast[]
  catalogPrices CatalogPrice[]

  @@unique([tenantId, id])
  @@map("counterparties")
}

// The publisher's base of cost categories (the domain's COST_CATEGORIES): a farm type hangs under one.
enum CostCategory {
  Feed
  Chicks
  Health
  Bedding
  Labour
  Equipment
  Cleaning
  Transport
  Processing
  Utilities
  FinancialCharges
  Other

  @@map("cost_category")
}

enum FeedStage {
  Starter
  Grower
  Finisher

  @@map("feed_stage")
}

enum CostBehaviour {
  Fixed
  Variable

  @@map("cost_behaviour")
}

// A cost type of the farm (N.2), under a category of the base that never changes. Never
// deleted, not even unused: archived (decision of 2026-11-09). Renaming changes only its label:
// entries carry its id. Orderable when its category is (read from the domain, not stored).
model CostType {
  tenantId   String        @map("tenant_id") @db.Uuid
  id         String        @id @db.Uuid
  category   CostCategory
  name       String
  behaviour  CostBehaviour
  // The usual weight of a bag of this feed, in grams (N.8a): copied on each order line; none
  // outside feed, nor for feed bought by weight.
  bagWeight  Int?          @map("bag_weight")
  // The stage of a feed by the age of the flock (N.9): the colour of its bag on the caretaker's
  // delivery card. Only the three feeds by age have one; never outside feed (CHECK).
  feedStage  FeedStage?    @map("feed_stage")
  archivedAt DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  orderLines OrderLine[]

  costs         Cost[]
  leftovers     CampaignLeftover[]
  catalogPrices CatalogPrice[]

  @@unique([tenantId, id])
  @@map("cost_types")
}

// A price the admin sets for an article (N.5), for one supplier or for all: it counts as paid at
// its moment, until a later price is paid. Added once, never updated nor deleted.
model CatalogPrice {
  tenantId   String   @map("tenant_id") @db.Uuid
  id         String   @id @db.Uuid
  costTypeId String   @map("cost_type_id") @db.Uuid
  // The supplier this price is for; none: for every supplier.
  supplierId String?  @map("supplier_id") @db.Uuid
  // Whole units of the farm's currency (rule 7), zero allowed.
  unitPrice  Int      @map("unit_price")
  setAt      DateTime @map("set_at") @db.Timestamptz(3)
  setBy      String   @map("set_by") @db.Uuid

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  costType CostType      @relation(fields: [tenantId, costTypeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  supplier Counterparty? @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, costTypeId])
  @@map("catalog_prices")
}

// A campaign's budget, a line a category (S.1): a plan, never a debt. Each writing adds its lines,
// under the identifier of the writing; the latest written counts (never updated nor deleted).
// A line without amount says « no budget » for its category.
model BudgetLine {
  tenantId   String       @map("tenant_id") @db.Uuid
  id         String       @db.Uuid
  category   CostCategory
  campaignId String       @map("campaign_id") @db.Uuid
  amount     Int?
  recordedAt DateTime     @map("recorded_at") @db.Timestamptz(3)
  recordedBy String       @map("recorded_by") @db.Uuid

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  campaign Campaign @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, id, category])
  @@index([tenantId, campaignId])
  @@map("budget_lines")
}

// The PIN attempts of an account on one device (E.10): failures in a row since its last success,
// and since when the account is known on it. Counted per device, so that hammering a number from
// one phone never slows the caretaker's own (R-14). Never deleted: reset to zero.
// The morning reminder sent for a site and the day whose deaths it asks for — yesterday (Y.3):
// the key makes it leave once per day and per site, whatever restarts. Written once, never changed.
model MorningReminder {
  tenantId String   @map("tenant_id") @db.Uuid
  siteId   String   @map("site_id") @db.Uuid
  day      DateTime @db.Date
  sentAt   DateTime @map("sent_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  site   Site   @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, siteId, day])
  @@map("morning_reminders")
}

// An alert sent for a planned reception (Q.15): the morning of its day, or the day it is written
// when its day has come already. The key makes it leave once per reception and per day. Written
// once, never changed.
model ReceptionAlert {
  tenantId    String   @map("tenant_id") @db.Uuid
  receptionId String   @map("reception_id") @db.Uuid
  day         DateTime @db.Date
  sentAt      DateTime @map("sent_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, receptionId, day])
  @@map("reception_alerts")
}

// The push subscription of a device (Y.1): one per device, to the person signed in on it (one
// phone = one person). Its sites are the person's at sending time. Deleted when the account is
// blocked or signed out everywhere, and when the device signs out.
model PushSubscription {
  tenantId  String   @map("tenant_id") @db.Uuid
  deviceId  String   @map("device_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  // The address of the browser's push service: Google, Mozilla, Apple or Microsoft only.
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, deviceId])
  @@index([tenantId, userId])
  @@map("push_subscriptions")
}

model SignInAttempt {
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  deviceId      String    @map("device_id") @db.Uuid
  failures      Int       @default(0)
  lastFailureAt DateTime? @map("last_failure_at") @db.Timestamptz(3)
  // The first successful sign-in of the account on this device: from then on, it is known.
  knownSince    DateTime? @map("known_since") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, userId, deviceId])
  @@map("sign_in_attempts")
}

// What was left of a type at the closing of a campaign (X.1, X.2): whole bags or units, and one
// opened at most, counted for half. Written once with the closing, never updated nor deleted; its
// value is recomputed from the orders (rule 8).
model CampaignLeftover {
  tenantId     String  @map("tenant_id") @db.Uuid
  campaignId   String  @map("campaign_id") @db.Uuid
  costTypeId   String  @map("cost_type_id") @db.Uuid
  whole        Int
  opened       Boolean
  // The grams left in the opened bag of feed, when the admin knows them (N.8d); none: half the bag.
  openedWeight Int?    @map("opened_weight")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  campaign Campaign @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  costType CostType @relation(fields: [tenantId, costTypeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, campaignId, costTypeId])
  @@map("campaign_leftovers")
}

// A purchase order of the farm (Q.1, Q.4), for one campaign. Its state is deduced, never stored
// (rule 8): from announcedAt, closedAt, the deliveries of the journal and the payments.
model PurchaseOrder {
  tenantId    String    @map("tenant_id") @db.Uuid
  id          String    @id @db.Uuid
  supplierId  String    @map("supplier_id") @db.Uuid
  campaignId  String    @map("campaign_id") @db.Uuid
  orderDay    DateTime  @map("order_day") @db.Date
  reference   String?
  // The farm's currency when the order was written (rule 7).
  currency    String
  announcedAt DateTime? @map("announced_at") @db.Timestamptz(3)
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supplier          Counterparty       @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  campaign          Campaign           @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  plannedReceptions PlannedReception[]
  lines             OrderLine[]
  payments          Payment[]

  @@unique([tenantId, id])
  @@index([tenantId, campaignId])
  @@map("purchase_orders")
}

enum PaymentMethod {
  Cash
  Wave
  OrangeMoney

  @@map("payment_method")
}

// A payment of an order (Q.9): a money entry, written once, never updated nor deleted (rule 2).
// Its identifier is made at the office: sent twice, it is kept once.
model Payment {
  tenantId   String        @map("tenant_id") @db.Uuid
  id         String        @id @db.Uuid
  orderId    String        @map("order_id") @db.Uuid
  paidOn     DateTime      @map("paid_on") @db.Date
  // In the smallest unit of the order's currency: never a float (rule 7).
  amount     Int
  method     PaymentMethod
  // Someone else who paid for the farm (R.4); null when the farm paid.
  paidById   String?       @map("paid_by_id") @db.Uuid
  // The admin who recorded it.
  recordedBy String        @map("recorded_by") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order  PurchaseOrder @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  paidBy Counterparty? @relation("PaymentPaidBy", fields: [tenantId, paidById], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, orderId])
  @@map("payments")
}

// A line of an order. A draft's lines are rewritten whole (Q.4): the only DELETE they allow.
model OrderLine {
  tenantId   String @map("tenant_id") @db.Uuid
  id         String @id @db.Uuid
  orderId    String @map("order_id") @db.Uuid
  // Its rank in the order, as the admin wrote it.
  position   Int
  costTypeId String @map("cost_type_id") @db.Uuid
  quantity   Int
  // In the smallest unit of the order's currency: never a float (rule 7).
  unitPrice  Int    @map("unit_price")
  // The weight of one bag of a feed line, in grams (N.8a): a fact of the purchase; none outside feed.
  bagWeight  Int?   @map("bag_weight")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order    PurchaseOrder @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  costType CostType      @relation(fields: [tenantId, costTypeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, orderId])
  @@map("order_lines")
}

enum RetentionClass {
  OperationalProof
  SupportingDocument

  @@map("retention_class")
}

// A media of the farm (M.1): the file lives on the media volume under its fingerprint; this row
// says what it is and who sent it. Added once, never updated nor deleted (rule 13). The same
// file sent by two farms is two rows, two files.
// A reception planned on an order received in several times (Q.14): each writing is a line — a
// version (a new date reschedules it), or its withdrawal —, the last written prevails, the earlier
// dates stay readable. Added, never updated nor deleted.
model PlannedReception {
  tenantId    String    @map("tenant_id") @db.Uuid
  id          String    @id @db.Uuid
  // The planned reception, the same through its writings.
  receptionId String    @map("reception_id") @db.Uuid
  orderId     String    @map("order_id") @db.Uuid
  // A withdrawal carries neither: CHECK in the migration.
  plannedOn   DateTime? @map("planned_on") @db.Date
  // [{ orderLineId, quantity }], judged by the domain.
  lines       Json?
  withdrawn   Boolean
  writtenAt   DateTime  @map("written_at") @db.Timestamptz(3)
  writtenBy   String    @map("written_by") @db.Uuid

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  order  PurchaseOrder @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, orderId])
  @@map("planned_receptions")
}

// How a planned sale is priced (W.4): by the bird, or by the kilo at its average weight.
enum ForecastPricing {
  PerBird
  PerKilo

  @@map("forecast_pricing")
}

// A planned sale of a flock (W.4), buyer by buyer: each writing is a line — a version, or its
// withdrawal —, the last written prevails. A plan, never a receivable. Added, never updated nor deleted.
model SaleForecast {
  tenantId      String           @map("tenant_id") @db.Uuid
  id            String           @id @db.Uuid
  // The planned sale, the same through its writings.
  forecastId    String           @map("forecast_id") @db.Uuid
  campaignId    String           @map("campaign_id") @db.Uuid
  // A withdrawal carries none of these: CHECK in the migration.
  buyerId       String?          @map("buyer_id") @db.Uuid
  week          DateTime?        @db.Date
  birds         Int?
  pricing       ForecastPricing?
  price         Int?
  // Grams: indicative by the bird, required by the kilo.
  averageWeight Int?             @map("average_weight")
  withdrawn     Boolean
  writtenAt     DateTime         @map("written_at") @db.Timestamptz(3)
  writtenBy     String           @map("written_by") @db.Uuid

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  campaign Campaign      @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  buyer    Counterparty? @relation(fields: [tenantId, buyerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, campaignId])
  @@map("sale_forecasts")
}

// What a supporting photo is joined to (R.6): an order, or a payment of an order.
enum AttachmentSubject {
  Order
  Payment

  @@map("attachment_subject")
}

// A photo joined to an order or a payment (R.6), at the time or later: the entry never changes,
// the joining is written apart. Added once, never updated nor deleted.
model Attachment {
  tenantId    String            @map("tenant_id") @db.Uuid
  id          String            @id @db.Uuid
  subjectKind AttachmentSubject @map("subject_kind")
  subjectId   String            @map("subject_id") @db.Uuid
  mediaSha256 String            @map("media_sha256")
  attachedAt  DateTime          @map("attached_at") @db.Timestamptz(3)
  attachedBy  String            @map("attached_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  media  Media  @relation(fields: [tenantId, mediaSha256], references: [tenantId, sha256], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, subjectKind, subjectId, mediaSha256])
  @@index([tenantId, subjectId])
  @@map("attachments")
}

model Media {
  tenantId       String         @map("tenant_id") @db.Uuid
  sha256         String
  byteSize       Int            @map("byte_size")
  contentType    String         @map("content_type")
  retentionClass RetentionClass @map("retention_class")
  uploadedBy     String         @map("uploaded_by") @db.Uuid
  deviceId       String         @map("device_id") @db.Uuid
  uploadedAt     DateTime       @map("uploaded_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attachments Attachment[]

  @@id([tenantId, sha256])
  @@map("media")
}

enum CostPaymentKind {
  Paid
  ToPay
  // Paid for the farm by someone else (R.4): `counterparty_id` names who.
  PaidBy

  @@map("cost_payment_kind")
}

// A cost of a campaign (P.1, P.2): a money entry, added once and never updated nor deleted. A
// correction is another row naming the cost it replaces (`corrects`); the latest written counts.
model Cost {
  tenantId       String          @map("tenant_id") @db.Uuid
  id             String          @id @db.Uuid
  corrects       String?         @db.Uuid
  campaignId     String          @map("campaign_id") @db.Uuid
  costTypeId     String          @map("cost_type_id") @db.Uuid
  spentOn        DateTime        @map("spent_on") @db.Date
  // In the smallest unit of the farm's currency: never a float (rule 7).
  amount         Int
  note           String?
  paymentKind    CostPaymentKind @map("payment_kind")
  counterpartyId String?         @map("counterparty_id") @db.Uuid
  // The fingerprint of the receipt's photo, on the media volume (P.5).
  receipt        String?
  recordedAt     DateTime        @map("recorded_at") @db.Timestamptz(3)
  recordedBy     String          @map("recorded_by") @db.Uuid

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  campaign     Campaign      @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  costType     CostType      @relation(fields: [tenantId, costTypeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  counterparty Counterparty? @relation(fields: [tenantId, counterpartyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  original     Cost?         @relation("CostCorrections", fields: [tenantId, corrects], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  corrections  Cost[]        @relation("CostCorrections")

  @@unique([tenantId, id])
  @@index([tenantId, campaignId])
  @@map("costs")
}

enum SettlementDirection {
  ToCounterparty
  FromCounterparty

  @@map("settlement_direction")
}

// A settlement with a counterparty, outside an order (R.2): a money entry, added once and never
// updated nor deleted. Balances are summed from it, never stored.
model Settlement {
  tenantId       String              @map("tenant_id") @db.Uuid
  id             String              @id @db.Uuid
  counterpartyId String              @map("counterparty_id") @db.Uuid
  paidOn         DateTime            @map("paid_on") @db.Date
  // In the smallest unit of the farm's currency: never a float (rule 7).
  amount         Int
  method         PaymentMethod
  direction      SettlementDirection
  recordedBy     String              @map("recorded_by") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  counterparty Counterparty @relation(fields: [tenantId, counterpartyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, counterpartyId])
  @@map("settlements")
}

enum SalePricingKind {
  PerBird
  PerKilo

  @@map("sale_pricing_kind")
}

// A sale of birds of a campaign (W.1): a money entry, added once and never updated nor deleted.
// Its amount is computed by the domain and kept for reading; the price stays as it was set.
model Sale {
  tenantId    String          @map("tenant_id") @db.Uuid
  id          String          @id @db.Uuid
  campaignId  String          @map("campaign_id") @db.Uuid
  buyerId     String          @map("buyer_id") @db.Uuid
  soldOn      DateTime        @map("sold_on") @db.Date
  birds       Int
  pricingKind SalePricingKind @map("pricing_kind")
  // Per bird: the price of a head; per kilo: the price of a kilo — whole units of the currency (rule 7).
  unitPrice   Int             @map("unit_price")
  // Per kilo only: the weight weighed, in whole grams.
  grams       Int?
  amount      Int
  recordedBy  String          @map("recorded_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  campaign Campaign      @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  buyer    Counterparty  @relation(fields: [tenantId, buyerId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  receipts SaleReceipt[]

  @@unique([tenantId, id])
  @@index([tenantId, campaignId])
  @@map("sales")
}

// Money received for a sale (W.1): added once, never updated nor deleted.
model SaleReceipt {
  tenantId   String        @map("tenant_id") @db.Uuid
  id         String        @id @db.Uuid
  saleId     String        @map("sale_id") @db.Uuid
  paidOn     DateTime      @map("paid_on") @db.Date
  amount     Int
  method     PaymentMethod
  recordedBy String        @map("recorded_by") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sale   Sale   @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, saleId])
  @@map("sale_receipts")
}

// The chef asks for a weighing of a flock, on a day (T.2). Added once; answered by a weighing of
// the journal that names it — nothing is stored about that, it is read from the journal.
model WeighingRequest {
  tenantId     String   @map("tenant_id") @db.Uuid
  id           String   @id @db.Uuid
  campaignId   String   @map("campaign_id") @db.Uuid
  requestedFor DateTime @map("requested_for") @db.Date
  requestedBy  String   @map("requested_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  campaign Campaign @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, campaignId])
  @@map("weighing_requests")
}
