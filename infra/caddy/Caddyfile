# Caddy sert le web statique et relaie l'API — docs/architecture.md §9.
# Repris de build-track (frontend/Caddyfile).
#
# Une seule origine : l'application et `/api/v1` répondent sur le même hôte. C'est ce qui
# permet de ne jamais activer CORS (CLAUDE.md §8). L'API n'est jointe que par ici, sur le
# réseau interne du compose.

# Sans SITE_ADDRESS : `:80`, en clair — développement et réseau local. Avec un nom de
# domaine, Caddy obtient et renouvelle seul son certificat (surcouche de production, Z.5).
{$SITE_ADDRESS::80} {
	root * /srv
	encode gzip zstd

	# Sur toutes les réponses, l'API comprise. HSTS : une fois venu en HTTPS, le navigateur n'y
	# renonce plus pendant un an (sans effet en clair, sur le réseau local). Anti-encadrement en
	# double : `frame-ancestors 'none'` pour les navigateurs récents, X-Frame-Options pour les autres.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# La sonde de disponibilité interroge la base à chaque appel : elle ne sert qu'aux contrôles
	# de santé, faits de l'intérieur des conteneurs, et n'est pas offerte à Internet (R-9).
	handle /api/v1/health/ready {
		respond 404
	}

	# Le conteneur `api` ne publie aucun port : cette ligne est le seul chemin vers lui.
	handle /api/v1/* {
		reverse_proxy api:3000
	}

	handle {
		# `default-src 'self'` ferme tout par défaut ; aucune origine externe n'est autorisée
		# (polices et scripts auto-hébergés). `style-src` tolère 'unsafe-inline' parce
		# qu'Angular pose des styles de composant en ligne ; `script-src` ne le tolère pas.
		header {
			Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		}

		# Fichiers au nom haché (`main-4PMYRGTK.js`) : immuables, un an de cache.
		@hashed path_regexp hashed -[0-9A-Z]{8,}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# Les fichiers dont le nom ne change pas et qui pilotent tout le reste : jamais mis
		# en cache, sinon une ancienne version de l'application descendrait indéfiniment — le
		# service worker et son index d'abord : ils décident de ce que le téléphone garde (G.1).
		@volatile path / /index.html /ngsw-worker.js /ngsw.json /safety-worker.js /manifest.webmanifest
		header @volatile Cache-Control "no-cache"

		# Repli SPA : une route Angular n'est pas un fichier ; sans cette ligne, rafraîchir
		# la page répond 404.
		try_files {path} /index.html
		file_server
	}
}

# Le contrôle de santé du conteneur (docker-compose.yml) : un port interne, jamais publié, qui
# répond quel que soit le domaine servi — `localhost` ne correspond pas au site en production.
:8081 {
	respond /healthz 200
}
